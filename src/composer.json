{
  "name": "tao996/phalconx",
  "type": "project",
  "description": "This application make the Phalcon framework write easy.",
  "keywords": [
    "phalcon",
    "php"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "ext-phalcon": "^5.23",
    "ext-bcmath": "*",
    "ext-curl": "*",
    "ext-gd": "*",
    "ext-intl": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-redis": "*",
    "ext-xlswriter": "*"
  },
  "require-dev": {
    "mockery/mockery": "^1.6",
    "phalcon/ide-stubs": "^5.23",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5",
    "viest/php-ext-xlswriter-ide-helper": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "App/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests"
    }
  },
  "config": {
    "sort-packages": true
  },
  "extra": [],
  "minimum-stability": "stable",
  "prefer-stable": true
}
